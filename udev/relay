#!/bin/bash
#
# Control the LCUS-1 style USB relay (CH340 serial) via /dev/relay.
#
# Protocol: 4 bytes, A0 <addr> <op> <checksum>, checksum = sum of first 3 bytes.
#   9600 8N1, no flow control.
#   on     A0 01 01 A2
#   off    A0 01 00 A1

set -eu

DEV=${RELAY_DEV:-/dev/relay}
BAUD=${RELAY_BAUD:-9600}

usage() {
    echo "usage: $0 {on|off}" >&2
    exit 2
}

[ $# -eq 1 ] || usage

# Open the port read-write once so we can send a command and read the reply
# without the port being reconfigured in between.  Set 9600 8N1 explicitly
# (raw mode, no echo) rather than relying on the tty defaults.
exec 3<>"$DEV"
stty -F "$DEV" "$BAUD" cs8 -cstopb -parenb -crtscts clocal -hupcl raw -echo

# Write a raw command frame (backslash escapes in the argument are expanded).
send() {
    printf '%b' "$1" >&3
}

case $1 in
    on)
        send '\xA0\x01\x01\xA2'
        echo "Relay on"
        ;;
    off)
        send '\xA0\x01\x00\xA1'
        echo "Relay off"
        ;;
    *)
        usage
        ;;
esac
